{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omarchy-ai-usage:provider-snapshot:v1",
  "title": "Omarchy AI Usage provider snapshot",
  "description": "The provider-neutral boundary consumed by the UI. Provider-specific payloads must be normalized before crossing it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "providerId",
    "displayName",
    "account",
    "status",
    "lastUpdated",
    "stale",
    "headlineWindowId",
    "windows"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "providerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 64
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "account": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/account"
        }
      ]
    },
    "status": {
      "enum": [
        "ACTIVE",
        "LOADING",
        "STALE",
        "NEEDS_AUTH",
        "RATE_LIMITED",
        "ERROR",
        "UNAVAILABLE"
      ]
    },
    "lastUpdated": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "stale": {
      "type": "boolean"
    },
    "headlineWindowId": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      ]
    },
    "windows": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/usageWindow"
      }
    },
    "message": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ACTIVE"
          }
        }
      },
      "then": {
        "properties": {
          "stale": {
            "const": false
          },
          "headlineWindowId": {
            "type": "string"
          },
          "windows": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "STALE"
          }
        }
      },
      "then": {
        "properties": {
          "stale": {
            "const": true
          },
          "lastUpdated": {
            "type": "string",
            "format": "date-time"
          },
          "windows": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stale": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "STALE"
          }
        }
      }
    }
  ],
  "$defs": {
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "plan"
      ],
      "properties": {
        "label": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          ]
        },
        "plan": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          ]
        }
      }
    },
    "usageWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "usedPercent",
        "remainingPercent",
        "resetAt",
        "durationMinutes",
        "fidelity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "usedPercent": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          ]
        },
        "remainingPercent": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          ]
        },
        "resetAt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "durationMinutes": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "fidelity": {
          "enum": [
            "OFFICIAL",
            "DERIVED",
            "MANUAL"
          ]
        }
      }
    }
  }
}
